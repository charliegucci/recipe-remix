{
  "name": "recipe-remix",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recipe-remix-db",
      "database_id": "bc8bdfcc-201c-4bda-b490-8b1f2df17da8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "recipe-remix-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "e5f67970ee6446f18f55151b2e5358c1"
    }
  ]
}
